# Copy to .env and fill in ONLY what you need. Never commit .env.
# With nothing set, ASTRA INTEL runs in local mode (extractive answers, no API needed).

# Option A: Anthropic (Claude)
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5-20251001

# Option B: any OpenAI-compatible server (OpenAI, Gemini's OpenAI endpoint, Groq, local Ollama ...)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1      # Ollama: http://localhost:11434/v1
# LLM_MODEL=gpt-4o-mini                       # Ollama example: llama3.1

# Optional
# MAX_UPLOAD_MB=25
# ASTRA_DB_PATH=data/astra_intel.db
# PORT=5000
